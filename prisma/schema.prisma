// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  role          String    @default("STUDENT") // STUDENT or ADMIN
  studentId     String?   @unique
  department    String?
  year          String?
  phone         String?
  
  // NextAuth
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Relations
  edicMembership EdicMembership?
  bookings       Booking[]       @relation("GroupLeader")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EdicMembership {
  id         String   @id @default(cuid())
  userId     String   @unique
  edicId     String?  @unique
  status     String   @default("PENDING") // ACTIVE, INACTIVE, PENDING
  joinedDate DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Room {
  id           String   @id @default(cuid())
  name         String
  roomNumber   String   @unique
  capacity     Int      @default(21)
  openTime     String   @default("09:00") // HH:mm
  closeTime    String   @default("18:00") // HH:mm
  
  bookings     Booking[]
  closures     RoomClosure[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Booking {
  id               String    @id @default(cuid())
  bookingId        String    @unique // e.g., RND-414-260908-0047
  roomId           String
  groupLeaderId    String
  date             DateTime  // Store as YYYY-MM-DD
  startTime        String    // HH:mm format
  endTime          String    // HH:mm format
  durationMinutes  Int
  peopleCount      Int
  purpose          String
  projectName      String?
  description      String?
  facultyMentor    String?
  equipmentReqs    String?   // JSON or comma separated
  specialReqs      String?
  status           String    @default("CONFIRMED") // CONFIRMED, ACTIVE, COMPLETED, CANCELLED, REJECTED, NO_SHOW
  cancellationReason String?
  checkInTime      DateTime?
  checkOutTime     DateTime?
  
  room             Room      @relation(fields: [roomId], references: [id])
  groupLeader      User      @relation("GroupLeader", fields: [groupLeaderId], references: [id])
  members          BookingMember[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model BookingMember {
  id         String  @id @default(cuid())
  bookingId  String
  name       String
  studentId  String?
  email      String?
  department String?
  year       String?
  isPresent  Boolean @default(false)
  
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model RoomClosure {
  id            String   @id @default(cuid())
  roomId        String
  startDateTime DateTime
  endDateTime   DateTime
  reason        String
  
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  details    String?  // JSON string of changes
  
  createdAt  DateTime @default(now())
}
